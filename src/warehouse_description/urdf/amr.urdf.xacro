<?xml version="1.0"?>
<!--
  Warehouse AMR: differential drive, 2D LiDAR, IMU, wheel odometry.

  One description is instantiated per robot. Everything that must not collide
  between robots (gz topics, gz frame ids, odom/TF frame ids) is derived from
  the robot_ns argument, e.g. robot_ns:=robot_3
    gz/ROS topics : /robot_3/{cmd_vel,odom,scan,imu,joint_states,tf}
    TF frames     : robot_3/odom -> robot_3/base_link -> robot_3/lidar_link ...
  (robot_state_publisher adds the "robot_3/" prefix to the URDF link names.)

  base_link sits on the wheel axle (REP-105 style centre of rotation).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="warehouse_amr">

  <!--  arguments (set from the launch file)  -->
  <xacro:arg name="robot_ns" default="robot_1"/>
  <xacro:arg name="accent_rgba" default="0.15 0.45 0.85 1.0"/>
  <xacro:arg name="lidar_rate" default="10"/>
  <xacro:arg name="lidar_samples" default="360"/>
  <xacro:arg name="lidar_range_max" default="12.0"/>
  <xacro:arg name="imu_rate" default="50"/>
  <xacro:arg name="odom_rate" default="30"/>

  <xacro:property name="ns" value="$(arg robot_ns)"/>
  <xacro:property name="lidar_rate" value="$(arg lidar_rate)"/>
  <xacro:property name="lidar_samples" value="$(arg lidar_samples)"/>
  <xacro:property name="lidar_range_max" value="$(arg lidar_range_max)"/>
  <xacro:property name="imu_rate" value="$(arg imu_rate)"/>
  <xacro:property name="odom_rate" value="$(arg odom_rate)"/>

  <!--  geometry / mass  -->
  <xacro:property name="chassis_x" value="0.55"/>
  <xacro:property name="chassis_y" value="0.32"/>
  <xacro:property name="chassis_z" value="0.12"/>
  <xacro:property name="chassis_mass" value="12.0"/>
  <xacro:property name="chassis_oz" value="0.04"/>          <!-- chassis centre above axle -->

  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="1.0"/>
  <xacro:property name="wheel_y" value="0.18"/>             <!-- |y| of wheel centre -->

  <xacro:property name="caster_radius" value="0.04"/>
  <xacro:property name="caster_x" value="0.20"/>
  <xacro:property name="caster_mass" value="0.2"/>

  <xacro:property name="max_lin_vel" value="1.0"/>
  <xacro:property name="max_ang_vel" value="2.0"/>

  <!--  materials  -->
  <material name="accent"><color rgba="$(arg accent_rgba)"/></material>
  <material name="wheel_black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="dark_grey"><color rgba="0.20 0.20 0.22 1"/></material>

  <!--  inertia helpers  -->
  <xacro:macro name="box_inertial" params="m x y z oz:=0">
    <inertial>
      <origin xyz="0 0 ${oz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0" izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${0.4*m*r*r}" ixy="0" ixz="0" iyy="${0.4*m*r*r}" iyz="0" izz="${0.4*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <!--  base_link (chassis)  -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_oz}" rpy="0 0 0"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
      <material name="accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_oz}" rpy="0 0 0"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
    </collision>
    <xacro:box_inertial m="${chassis_mass}" x="${chassis_x}" y="${chassis_y}" z="${chassis_z}" oz="${chassis_oz}"/>
  </link>

  <!--  drive wheels (axis +y, left = +y per REP-103)  -->
  <xacro:macro name="drive_wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12.0}" ixy="0" ixz="0"
                 iyy="${0.5*wheel_mass*wheel_radius*wheel_radius}" iyz="0"
                 izz="${wheel_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12.0}"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel side="left" y="${wheel_y}"/>
  <xacro:drive_wheel side="right" y="${-wheel_y}"/>

  <!--  frictionless casters (front + rear: stable under braking)  -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertial m="${caster_mass}" r="${caster_radius}"/>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${name}_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="caster_front" x="${caster_x}"/>
  <xacro:caster name="caster_rear" x="${-caster_x}"/>

  <!--  LiDAR  -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.15 0 0.13" rpy="0 0 0"/>
  </joint>

  <!--  IMU  -->
  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <!--  Gazebo: sensors  -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>${ns}/lidar_link</gz_frame_id>
      <topic>/${ns}/scan</topic>
      <update_rate>${lidar_rate}</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_samples}</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>${lidar_range_max}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <gz_frame_id>${ns}/imu_link</gz_frame_id>
      <topic>/${ns}/imu</topic>
      <update_rate>${imu_rate}</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!--  Gazebo: drive + odometry + joint states  -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2*wheel_y}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/${ns}/cmd_vel</topic>
      <odom_topic>/${ns}/odom</odom_topic>
      <tf_topic>/${ns}/tf</tf_topic>
      <frame_id>${ns}/odom</frame_id>
      <child_frame_id>${ns}/base_link</child_frame_id>
      <odom_publish_frequency>$(arg odom_rate)</odom_publish_frequency>
      <max_linear_velocity>${max_lin_vel}</max_linear_velocity>
      <min_linear_velocity>${-max_lin_vel}</min_linear_velocity>
      <max_angular_velocity>${max_ang_vel}</max_angular_velocity>
      <min_angular_velocity>${-max_ang_vel}</min_angular_velocity>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <min_linear_acceleration>-1.5</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/${ns}/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>

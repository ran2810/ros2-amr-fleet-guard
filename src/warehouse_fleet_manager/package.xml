<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warehouse_fleet_manager</name>
  <version>0.1.0</version>
  <description>Fleet manager: task queue, closest-available-healthy-robot allocation with battery check, fleet status.</description>
  <maintainer email="prkr@mail.de">Ranjith</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>warehouse_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>warehouse_robot_agent</exec_depend>
  <exec_depend>warehouse_navigation</exec_depend>
  <exec_depend>warehouse_gazebo</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
